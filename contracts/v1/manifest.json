{
  "version": "1.0.0",
  "endpoints": {
    "health": {
      "method": "GET",
      "path": "/health"
    },
    "recommendations": {
      "method": "POST",
      "path": "/api/recommendations",
      "request_content_type": "application/json",
      "response_content_type": "application/json",
      "success_http_status": 200,
      "error_http_status": 200,
      "notes": "Business errors return HTTP 200 with ok=false. Transport failures use non-2xx status."
    },
    "contract": {
      "method": "GET",
      "path": "/api/contract"
    }
  },
  "request": {
    "description": "Normalized preference payload sent by the frontend.",
    "schema": {
      "description": "POST /api/recommendations body \u2014 preferences plus optional dev toggle.",
      "properties": {
        "location": {
          "title": "Location",
          "type": "string"
        },
        "budget": {
          "enum": [
            "low",
            "medium",
            "high"
          ],
          "title": "Budget",
          "type": "string"
        },
        "cuisine": {
          "title": "Cuisine",
          "type": "string"
        },
        "min_rating": {
          "default": 0.0,
          "maximum": 5.0,
          "minimum": 0.0,
          "title": "Min Rating",
          "type": "number"
        },
        "extras": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Extras"
        },
        "use_mock_data": {
          "default": false,
          "description": "When true, use in-memory mock restaurants instead of processed data.",
          "title": "Use Mock Data",
          "type": "boolean"
        }
      },
      "required": [
        "location",
        "budget",
        "cuisine"
      ],
      "title": "ApiRecommendationsRequest",
      "type": "object"
    },
    "required_fields": [
      "location",
      "budget",
      "cuisine"
    ],
    "optional_fields": [
      "min_rating",
      "extras",
      "use_mock_data"
    ]
  },
  "response": {
    "description": "Discriminated union on ok; shape is stable for success and error paths.",
    "schema": {
      "$defs": {
        "BackendErrorResponse": {
          "description": "User-safe backend error response.",
          "properties": {
            "ok": {
              "const": false,
              "default": false,
              "title": "Ok",
              "type": "boolean"
            },
            "error_code": {
              "enum": [
                "validation_error",
                "config_error",
                "runtime_error"
              ],
              "title": "Error Code",
              "type": "string"
            },
            "message": {
              "title": "Message",
              "type": "string"
            }
          },
          "required": [
            "error_code",
            "message"
          ],
          "title": "BackendErrorResponse",
          "type": "object"
        },
        "BackendSuccessResponse": {
          "description": "Successful backend response.",
          "properties": {
            "ok": {
              "const": true,
              "default": true,
              "title": "Ok",
              "type": "boolean"
            },
            "result": {
              "$ref": "#/$defs/RecommendationResult"
            }
          },
          "required": [
            "result"
          ],
          "title": "BackendSuccessResponse",
          "type": "object"
        },
        "RecommendationItem": {
          "description": "A single ranked recommendation with AI explanation.",
          "properties": {
            "rank": {
              "minimum": 1,
              "title": "Rank",
              "type": "integer"
            },
            "restaurant_id": {
              "title": "Restaurant Id",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "explanation": {
              "title": "Explanation",
              "type": "string"
            },
            "cuisines": {
              "items": {
                "type": "string"
              },
              "title": "Cuisines",
              "type": "array"
            },
            "rating": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Rating"
            },
            "average_cost": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Average Cost"
            },
            "cost_band": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cost Band"
            }
          },
          "required": [
            "rank",
            "restaurant_id",
            "name",
            "explanation"
          ],
          "title": "RecommendationItem",
          "type": "object"
        },
        "RecommendationResult": {
          "description": "Full recommendation response from the pipeline.",
          "properties": {
            "summary": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Summary"
            },
            "recommendations": {
              "items": {
                "$ref": "#/$defs/RecommendationItem"
              },
              "title": "Recommendations",
              "type": "array"
            },
            "used_llm_fallback": {
              "default": false,
              "title": "Used Llm Fallback",
              "type": "boolean"
            },
            "filter_match_count": {
              "default": 0,
              "title": "Filter Match Count",
              "type": "integer"
            }
          },
          "title": "RecommendationResult",
          "type": "object"
        }
      },
      "anyOf": [
        {
          "$ref": "#/$defs/BackendSuccessResponse"
        },
        {
          "$ref": "#/$defs/BackendErrorResponse"
        }
      ]
    },
    "success": {
      "$defs": {
        "RecommendationItem": {
          "description": "A single ranked recommendation with AI explanation.",
          "properties": {
            "rank": {
              "minimum": 1,
              "title": "Rank",
              "type": "integer"
            },
            "restaurant_id": {
              "title": "Restaurant Id",
              "type": "string"
            },
            "name": {
              "title": "Name",
              "type": "string"
            },
            "explanation": {
              "title": "Explanation",
              "type": "string"
            },
            "cuisines": {
              "items": {
                "type": "string"
              },
              "title": "Cuisines",
              "type": "array"
            },
            "rating": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Rating"
            },
            "average_cost": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Average Cost"
            },
            "cost_band": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Cost Band"
            }
          },
          "required": [
            "rank",
            "restaurant_id",
            "name",
            "explanation"
          ],
          "title": "RecommendationItem",
          "type": "object"
        },
        "RecommendationResult": {
          "description": "Full recommendation response from the pipeline.",
          "properties": {
            "summary": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Summary"
            },
            "recommendations": {
              "items": {
                "$ref": "#/$defs/RecommendationItem"
              },
              "title": "Recommendations",
              "type": "array"
            },
            "used_llm_fallback": {
              "default": false,
              "title": "Used Llm Fallback",
              "type": "boolean"
            },
            "filter_match_count": {
              "default": 0,
              "title": "Filter Match Count",
              "type": "integer"
            }
          },
          "title": "RecommendationResult",
          "type": "object"
        }
      },
      "description": "Successful backend response.",
      "properties": {
        "ok": {
          "const": true,
          "default": true,
          "title": "Ok",
          "type": "boolean"
        },
        "result": {
          "$ref": "#/$defs/RecommendationResult"
        }
      },
      "required": [
        "result"
      ],
      "title": "BackendSuccessResponse",
      "type": "object"
    },
    "error": {
      "description": "User-safe backend error response.",
      "properties": {
        "ok": {
          "const": false,
          "default": false,
          "title": "Ok",
          "type": "boolean"
        },
        "error_code": {
          "enum": [
            "validation_error",
            "config_error",
            "runtime_error"
          ],
          "title": "Error Code",
          "type": "string"
        },
        "message": {
          "title": "Message",
          "type": "string"
        }
      },
      "required": [
        "error_code",
        "message"
      ],
      "title": "BackendErrorResponse",
      "type": "object"
    }
  },
  "error_codes": [
    "validation_error",
    "config_error",
    "runtime_error"
  ]
}
