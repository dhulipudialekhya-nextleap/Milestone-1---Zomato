# Copy these into Railway → your service → Variables
# Docs: Docs/deployment-railway-vercel.md

LLM_PROVIDER=mock
LLM_MODEL=llama-3.1-8b-instant
LOG_LEVEL=INFO
SHORTLIST_SIZE=15
DISPLAY_TOP_K=5
DISABLE_DATA_INGEST=true

# Required after Vercel deploy (exact origin, no trailing slash):
# CORS_ORIGINS=https://your-project.vercel.app

# For live Groq recommendations:
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_your_key_here

# Optional if you commit a small sample CSV:
# PROCESSED_DATA_PATH=data/processed/restaurants_sample.csv
