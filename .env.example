# Application
LOG_LEVEL=INFO
SCHEMA_VERSION=1

# Dataset (Phase 1)
# Use .csv by default to avoid optional parquet engine dependency.
PROCESSED_DATA_PATH=data/processed/restaurants.csv
DATASET_SOURCE=https://huggingface.co/datasets/ManikaSaini/zomato-restaurant-recommendation

# Filtering (Phase 3)
SHORTLIST_SIZE=15
DISPLAY_TOP_K=5

# LLM (Phase 4) — set LLM_PROVIDER=groq and provide LLM_API_KEY for real calls
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=llama-3.1-8b-instant

# Budget bands (cost for two, INR) — used in Phase 1 normalization
BUDGET_LOW_MAX=300
BUDGET_MEDIUM_MAX=700

# Backend API (Phase 6/7) — CORS for Next.js frontend
# Local dev:
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Railway production (add your Vercel URL, comma-separated, no trailing slash):
# CORS_ORIGINS=https://your-app.vercel.app

# Railway / production (set in Railway dashboard, not in git)
# PORT=8080
# DISABLE_DATA_INGEST=true
# LLM_PROVIDER=groq
# LLM_API_KEY=your-groq-key
